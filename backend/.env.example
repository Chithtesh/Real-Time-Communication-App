# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.

PORT=5000

# Local MongoDB:  mongodb://127.0.0.1:27017/connecthub
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connecthub
MONGODB_URI=mongodb://127.0.0.1:27017/connecthub

# Generate a long random secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:4200
MAX_FILE_SIZE_MB=25

# Optional TURN server (needed for reliable video across NATs/firewalls in production)
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password
